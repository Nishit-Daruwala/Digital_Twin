# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5433/twin
TEST_DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5433/twin_test

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# LLM: openai (real) or fake (offline, deterministic; used by tests)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embeddings: local (sentence-transformers, 384 dims), openai (text-embedding-3-small @ 384 dims) or fake
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384

# Chat: max messages per user per minute
CHAT_RATE_LIMIT_PER_MIN=20

# Synthetic demo data endpoint (/demo/seed). Keep false in production.
DEMO_ENABLED=true
