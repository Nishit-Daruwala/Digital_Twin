# Copy to .env and fill in. Never commit .env.
# development / test / production. Production refuses to start with a weak JWT_SECRET,
# a wildcard CORS_ORIGINS, or an 'openai' provider without OPENAI_API_KEY.
APP_ENV=development

DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5433/twin
TEST_DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5433/twin_test

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# LLM: openai (real) or fake (offline, deterministic; used by tests)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embeddings: local (sentence-transformers, 384 dims), openai (text-embedding-3-small @ 384 dims) or fake
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384

# Rate limits (per process): chat messages per user per minute; login attempts per account
# per minute (3x that per IP); new accounts per IP per hour
CHAT_RATE_LIMIT_PER_MIN=20
LOGIN_RATE_LIMIT_PER_MIN=10
REGISTER_RATE_LIMIT_PER_HOUR=20

# Synthetic demo data endpoint (/demo/seed). Keep false in production.
DEMO_ENABLED=true

# Nightly ML pipeline (runs inside the API process) and where trained models are saved
SCHEDULER_ENABLED=true
NIGHTLY_HOUR=2
# MODEL_STORE_DIR=./model_store
MODEL_VERSIONS_KEPT=3
DEMO_BACKTEST_DAYS=14

# Insight sentences reworded by the LLM (numbers checked against the evidence)
INSIGHT_LLM_WORDING=true
# Recommendations: thompson (default), weights (the plan's +0.1 / -0.15 rule) or relevance
RECOMMEND_POLICY=thompson
